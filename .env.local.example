# ─────────────────────────────────────────────────────────────
# 複製這個檔案為 .env.local，再填入你的實際值。詳細步驟見 SETUP.md
# ─────────────────────────────────────────────────────────────

# Firebase 前端 SDK（後台登入頁用）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK（伺服器端，服務帳戶 JSON）
# 可直接貼 JSON，或用 base64 編碼：base64 -i serviceAccount.json | pbcopy
FIREBASE_SERVICE_ACCOUNT_KEY=
# Storage bucket 名稱（選用，保留相容既有 Firebase Storage 圖片）
FIREBASE_STORAGE_BUCKET=

# Vercel Blob（圖片的儲存後端）
# 作品封面存在 Blob，前台是靠 /api/cover 由伺服器讀出來縮圖後才吐給瀏覽器，
# blob 的公開網址不會出現在頁面上。這個變數沒填的話，本機連封面都顯示不出來。
# Vercel：專案 → Storage → 連結 Blob store 後由平台自動注入。
# 本機開發：到 Blob store 頁面的 Tokens 複製一組 read-write token 貼在這裡。
BLOB_READ_WRITE_TOKEN=

# 綠界 ECPay 金流（抖內用）
# 以下為綠界官方「測試環境」公開測試值，可直接使用，不會實際扣款。
# 上線時改成你自己的正式商店代號與金鑰，並把 ECPAY_ENV 改成 production。
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_ENV=stage

# 網站對外網址（綠界付款完成後導回用；本機開發用 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 評估 ID（格式 G-XXXXXXXXXX）
# 到 https://analytics.google.com 建立 GA4 資源後，在「管理 → 資料串流」取得。
# 留空則不會載入 GA（本機開發通常留空，正式站再填）。
NEXT_PUBLIC_GA_ID=
